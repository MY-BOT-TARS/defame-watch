{
  "manifest_version": 3,
  "name": "DefameWatch",
  "version": "0.1.0",
  "description": "Reveals the true review quality behind Google Maps ratings — calculates the actual banning rate from defamation-based removals in the last 365 days.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.googleusercontent.com/maps/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.com/maps/preview/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/injection.css"],
      "run_at": "document_idle"
    }
  ]
}
